HOST=127.0.0.1
PORT=3000
# When Node is behind an HTTPS reverse proxy:
# OPENREEL_PUBLIC_ORIGIN=https://research.example.com
# Optional grounded text synthesis. Library research works without a key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# Optional web-assisted public-profile discovery in Live search (paid OpenAI tools).
# Requires Responses web_search + strict structured output; disabled by default.
# OPENREEL_WEB_DISCOVERY=true
# OPENAI_DISCOVERY_MODEL=gpt-5.4-mini
# Optional chat synthesis deadline, 10000–180000 ms; default 25000.
# OPENREEL_CHAT_TIMEOUT_MS=90000
# Sampled-video analysis requires a vision-capable model and OPENAI_API_KEY.
# Falls back to an explicitly configured OPENAI_MODEL if omitted.
# OPENAI_VISION_MODEL=your-vision-capable-model
# Reasoning-model vision requests: low, medium or high; default medium.
# OPENAI_VISION_REASONING_EFFORT=medium
# Optional live discovery: at most 30 records; requested $0.25 maximum run charge.
# Check a timed-out Apify run before repeating. No automatic retries.
# APIFY_API_TOKEN=
# APIFY_ACTOR_ID=clockworks~tiktok-scraper
# Set a strong token before exposing paid AI, vision, or live discovery publicly.
# OPENREEL_API_TOKEN=

# Strict structured output is the default. Legacy providers may use json_object.
# OPENAI_VISION_RESPONSE_FORMAT=json_schema
# Optional operator deadline, 10000–180000 ms; default 45000. CPU models may need 90000.
# OPENREEL_VISION_TIMEOUT_MS=90000
# Optional actual speech transcription of locally extracted WAV chunks.
# OPENAI_TRANSCRIPTION_MODEL=your-transcription-model
# Optional separate endpoint, e.g. a local whisper.cpp server.
# OPENAI_TRANSCRIPTION_BASE_URL=http://127.0.0.1:4320/v1
# Optional Node24 SQLite corpus; separate from the 2,000-record browser library.
# OPENREEL_CORPUS_PATH=data/corpus.sqlite

# Optional canonical public-post metadata: Import URL, Live and creator collection.
# Import: one GET. Collection: up to6 selected GETs,3concurrent,20s shared budget.
# Each page:1MiB/10s; no media, retries or oEmbed fallback. Default uses oEmbed.
# OPENREEL_POST_METADATA=true

# Optional local public-source video review. Uses already installed Playwright/Chromium.
# Absolute operator paths only; no automatic installation. Keeps <=2 captures for 10 minutes.
# OPENREEL_PLAYWRIGHT_MODULE=/absolute/path/to/playwright
# OPENREEL_BROWSER_PATH=/absolute/path/to/chromium

# Optional public-source opening speech: requires the local browser paths and transcription model.
# Samples up to 30 source seconds; machine words are unverified, later audio is not covered.
# OPENREEL_SOURCE_AUDIO=true
